# ---- Hindsight (Cloud or local) ----
# Cloud: https://api.hindsight.vectorize.io  (get key at https://ui.hindsight.vectorize.io)
# Local (docker/open-source): http://localhost:8888  (leave API key empty)
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=your-hindsight-api-key

# ---- Groq ----
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3-32b

# Set to 1 on a deployed app when the history is already loaded in Hindsight
# SEED_LOADED=1

# Login page: set to 0 to skip it (local development only)
# AUTH_REQUIRED=1
